#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
================================================================================
GENERATE_PROCESSES.PY
--------------------------------------------------------------------------------
Generador de PROCESS presets de OrcaSlicer a partir de processes.yaml.

Mismo modelo de herencia que generate_profiles.py: cada process hereda de
un process base de sistema que incluye tu Kobra 2 Neo, evitando "Unsupported".

USO:
    python generate_processes.py                 # Genera todos
    python generate_processes.py --dry-run       # Simula sin escribir
    python generate_processes.py --process NOMBRE # Solo uno

REQUISITOS:
    pip install pyyaml
================================================================================
"""

import argparse
import json
import os
import sys
from datetime import datetime
from pathlib import Path

try:
    import yaml
except ImportError:
    print("❌ Falta dependencia: pyyaml")
    print("   Instala con: pip install pyyaml")
    sys.exit(1)


SCRIPT_DIR = Path(__file__).parent.absolute()
YAML_CONFIG = SCRIPT_DIR / "processes.yaml"
BACKUP_DIR = SCRIPT_DIR / "backups_process"

# Mapeo de patrones de infill simples → nombres de OrcaSlicer
INFILL_PATTERN_MAP = {
    "gyroid": "gyroid",
    "grid": "grid",
    "cubic": "cubic",
    "honeycomb": "honeycomb",
    "rectilinear": "rectilinear",
    "concentric": "concentric",
    "triangles": "triangles",
}

# Mapeo de tipos de brim simples → nombres de OrcaSlicer
BRIM_TYPE_MAP = {
    "outer_only": "outer_only",
    "inner_only": "inner_only",
    "outer_and_inner": "outer_and_inner",
    "no_brim": "no_brim",
    "auto": "auto_brim",
}


def load_config():
    """Carga y valida processes.yaml."""
    if not YAML_CONFIG.exists():
        print(f"❌ No se encontró el archivo: {YAML_CONFIG}")
        sys.exit(1)

    with open(YAML_CONFIG, "r", encoding="utf-8") as f:
        try:
            config = yaml.safe_load(f)
        except yaml.YAMLError as e:
            print(f"❌ Error parseando YAML: {e}")
            sys.exit(1)

    if "printer" not in config:
        print("❌ El YAML debe tener una sección 'printer'")
        sys.exit(1)

    if "processes" not in config or not config["processes"]:
        print("❌ El YAML debe tener al menos un process en 'processes'")
        sys.exit(1)

    return config


def expand_path(path_str):
    """Expande ~ y variables de entorno."""
    return Path(os.path.expandvars(os.path.expanduser(path_str)))


def resolve_orca_dir(path_str, subfolder):
    """
    Resuelve el directorio REAL donde OrcaSlicer lee los presets.

    Problema: OrcaSlicer guarda en DOS lugares según si iniciaste sesión:
      - user/default/<subfolder>/        → sin cuenta (legacy)
      - user/<UUID>/<subfolder>/         → con cuenta sincronizada (gana)

    Si existe una carpeta de cuenta (UUID) con presets, OrcaSlicer lee de
    ESA y la prioriza. Escribir en default/ cuando hay cuenta = el preset
    nunca se ve. Esta función detecta automáticamente la carpeta de cuenta
    activa y devuelve la ruta correcta, sin hardcodear el UUID (que puede
    cambiar al re-loguear o cambiar de versión).

    Estrategia: subir hasta la carpeta 'user/', buscar subcarpetas que
    parezcan UUID (36 chars con guiones) y que contengan <subfolder>.
    Si hay una con archivos, esa gana. Si no, default/.
    """
    configured = expand_path(path_str)

    # Subir hasta encontrar la carpeta 'user'
    user_dir = None
    for parent in [configured] + list(configured.parents):
        if parent.name == "user":
            user_dir = parent
            break
    if user_dir is None or not user_dir.exists():
        return configured  # no pudimos ubicar 'user', usar lo configurado

    # Buscar carpetas de cuenta (UUID) con presets reales
    candidates = []
    for child in user_dir.iterdir():
        if not child.is_dir() or child.name == "default":
            continue
        # Un UUID tiene 36 caracteres y 4 guiones
        if len(child.name) == 36 and child.name.count("-") == 4:
            sub = child / subfolder
            if sub.exists() and any(sub.glob("*.json")):
                # Contar archivos para elegir la más "poblada" si hay varias
                n = len(list(sub.glob("*.json")))
                candidates.append((n, sub))

    if candidates:
        # La carpeta de cuenta con más presets es la activa
        candidates.sort(reverse=True)
        chosen = candidates[0][1]
        return chosen

    # Sin carpeta de cuenta: usar la configurada (default/)
    return configured


def validate_process(process, index):
    """Valida campos mínimos de un process."""
    required = ["name", "settings"]
    for field in required:
        if field not in process:
            print(f"❌ Process #{index + 1}: falta el campo '{field}'")
            return False
    return True


def build_orca_process(process, orca_version, inherits_base):
    """
    Construye el dict del process preset usando modelo de herencia.
    Solo declara los campos que sobreescribimos; el resto se hereda.
    """
    s = process["settings"]

    infill_pattern = INFILL_PATTERN_MAP.get(
        s.get("sparse_infill_pattern", "gyroid"), "gyroid"
    )
    brim_type = BRIM_TYPE_MAP.get(s.get("brim_type", "outer_only"), "outer_only")

    profile = {
        "type": "process",
        "name": process["name"],
        "from": "User",
        "is_custom_defined": "1",
        "version": f"{orca_version}.0",
        "inherits": inherits_base,

        # Capas
        "layer_height": [str(s["layer_height"])],
        "initial_layer_print_height": [str(s["first_layer_height"])],

        # Paredes
        "wall_loops": [str(s["wall_loops"])],
        "top_shell_layers": [str(s["top_shell_layers"])],
        "bottom_shell_layers": [str(s["bottom_shell_layers"])],

        # Infill
        "sparse_infill_density": [f"{s['sparse_infill_density']}%"],
        "sparse_infill_pattern": [infill_pattern],

        # Velocidades
        "outer_wall_speed": [str(s["outer_wall_speed"])],
        "inner_wall_speed": [str(s["inner_wall_speed"])],
        "sparse_infill_speed": [str(s["infill_speed"])],
        "top_surface_speed": [str(s["top_surface_speed"])],
        "initial_layer_speed": [str(s["initial_layer_speed"])],
        "travel_speed": [str(s["travel_speed"])],

        # Aceleraciones
        "outer_wall_acceleration": [str(s["outer_wall_acceleration"])],
        "default_acceleration": [str(s["default_acceleration"])],

        # Adhesión
        "brim_type": [brim_type],
        "brim_width": [str(s["brim_width"])],
        # Gap entre brim y pieza: >0 hace que el brim se despegue de un tirón
        # sin tener que recortar. 0 = brim pegado (hay que cortar).
        "brim_object_gap": [str(s.get("brim_object_gap", 0.1))],

        # Precisión / compensación dimensional
        # Elephant foot compensation: encoge la primera capa hacia adentro
        # para compensar el aplastamiento que crea el labio/reborde en la
        # base. Elimina los sobrantes que toca recortar alrededor.
        "elefant_foot_compensation": [str(s.get("elephant_foot_compensation", 0.15))],

        # Soportes
        "enable_support": ["1" if s.get("enable_support", False) else "0"],
    }

    # Parámetros de costura (Z-seam): controlan dónde y cómo se cierra cada
    # capa. Si existe el bloque "seam", se aplican; si no, valores por defecto.
    seam = s.get("seam", {})
    seam_position_map = {
        "aligned": "aligned",
        "back": "back",
        "nearest": "nearest",
        "random": "random",
    }
    seam_pos = seam_position_map.get(seam.get("position", "aligned"), "aligned")

    profile.update({
        # Posición de la costura
        "seam_position": [seam_pos],
        # Seam gap: retrae un pelín antes de cerrar (0-15% es óptimo).
        # Reduce el blob al final de cada capa.
        "seam_gap": [seam.get("gap", "10%")],
        # Wipe (limpieza del nozzle) para costuras tradicionales más limpias
        "role_based_wipe_speed": ["1"],
        "wipe_on_loops": ["1" if seam.get("wipe_on_loops", True) else "0"],
        "wipe_before_external_loop": ["1"],
    })

    # SCARF SEAM (costura en bisel/rampa): la solución nuclear para ocultar
    # la costura, especialmente en superficies curvas como cilindros.
    # En vez de cortar la capa de golpe, hace una transición en rampa.
    if seam.get("scarf", False):
        scarf_type_map = {
            "contour": "Contour",          # solo perímetro exterior
            "contour_and_hole": "Contour and hole",
            "all": "All walls",
        }
        scarf_type = scarf_type_map.get(seam.get("scarf_type", "contour"), "Contour")
        profile.update({
            # Tipo de scarf. seam_slope_conditional activa el modo inteligente:
            # usa scarf solo en curvas, costura normal en esquinas rectas.
            "seam_slope_type": [scarf_type],
            "seam_slope_conditional": ["1" if seam.get("scarf_conditional", True) else "0"],
            # Ángulo umbral: sobre este ángulo aplica scarf (155 = default bueno)
            "scarf_angle_threshold": [str(seam.get("scarf_angle_threshold", 155))],
            # Velocidad del scarf: <100mm/s para mejor calidad
            "scarf_joint_speed": [seam.get("scarf_speed", "100%")],
            # Flow del scarf: 100% es lo recomendado
            "scarf_joint_flow_ratio": [str(seam.get("scarf_flow", 1.0))],
            # Longitud de la rampa (mm). 0 desactiva. ~10mm típico.
            "seam_slope_min_length": [str(seam.get("scarf_min_length", 10))],
            # Pasos de la transición (10 = suficiente)
            "seam_slope_steps": [str(seam.get("scarf_steps", 10))],
            # No envolver todo el perímetro (aumenta tiempo sin mejorar)
            "seam_slope_entire_loop": ["0"],
            # No aplicar a paredes internas (impacto mínimo)
            "seam_slope_inner_walls": ["1" if seam.get("scarf_inner_walls", False) else "0"],
        })

    # Agregar los parámetros de soporte si existe el bloque "support",
    # INCLUSO si enable_support es false. Así quedan pre-configurados y,
    # cuando el usuario active soportes en OrcaSlicer (checkbox), ya salen
    # con los valores de despegue fácil sin tener que configurar nada.
    if "support" in s:
        sup = s.get("support", {})

        # Tipo de soporte: "tree" (auto orgánico) o "normal" (auto rectilíneo)
        support_type_map = {
            "tree": "tree(auto)",
            "normal": "normal(auto)",
            "tree_manual": "tree(manual)",
            "normal_manual": "normal(manual)",
        }
        support_type = support_type_map.get(sup.get("type", "normal"), "normal(auto)")

        profile.update({
            "support_type": [support_type],

            # --- LOS PARÁMETROS CLAVE DEL DESPEGUE ---
            # Top Z distance: separación vertical soporte→pieza (gap de aire)
            "support_top_z_distance": [str(sup.get("top_z_distance", 0.2))],
            "support_bottom_z_distance": [str(sup.get("bottom_z_distance", 0.2))],

            # Top interface layers: capas densas de contacto. 0 = despegue
            # máximo, 1 = balance, 2+ = mejor acabado pero MUY pegado.
            # Este es el parámetro que causaba el problema de adhesión fuerte.
            "support_interface_top_layers": [str(sup.get("top_interface_layers", 0))],
            "support_interface_bottom_layers": [str(sup.get("bottom_interface_layers", 0))],

            # Interface spacing: espacio entre líneas de la interface.
            # Más espacio = menos contacto = despegue más fácil.
            "support_interface_spacing": [str(sup.get("interface_spacing", 0.5))],

            # XY distance: separación horizontal soporte→pieza
            "support_object_xy_distance": [str(sup.get("xy_distance", 0.35))],
            "support_object_first_layer_gap": [str(sup.get("first_layer_gap", 0.2))],

            # Densidad y umbral
            "support_base_pattern": [sup.get("base_pattern", "rectilinear")],
            "support_threshold_angle": [str(sup.get("threshold_angle", 40))],
            "support_on_build_plate_only": ["1" if sup.get("on_build_plate_only", False) else "0"],

            # First layer density del soporte (adhesión a la CAMA, no a la pieza)
            "raft_first_layer_density": [f"{sup.get('first_layer_density', 60)}%"],
        })

        # Parámetros específicos de árbol (solo si es tree)
        if "tree" in support_type:
            profile.update({
                "tree_support_tip_diameter": [str(sup.get("tree_tip_diameter", 0.8))],
                "tree_support_branch_distance": [str(sup.get("tree_branch_distance", 1.0))],
                "tree_support_branch_diameter": [str(sup.get("tree_branch_diameter", 2.0))],
            })

    return profile


def save_profile(profile, output_path, dry_run=False):
    """Guarda el process JSON, con backup del existente."""
    if dry_run:
        print(f"   [DRY-RUN] Escribiría a: {output_path}")
        return

    if output_path.exists():
        BACKUP_DIR.mkdir(exist_ok=True)
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_path = BACKUP_DIR / f"{output_path.stem}_{timestamp}.json"
        backup_path.write_text(output_path.read_text(encoding="utf-8"),
                               encoding="utf-8")
        print(f"   📦 Backup: {backup_path.name}")

    output_path.parent.mkdir(parents=True, exist_ok=True)
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(profile, f, indent=4, ensure_ascii=False)


def main():
    parser = argparse.ArgumentParser(
        description="Generador de process presets para OrcaSlicer"
    )
    parser.add_argument("--dry-run", action="store_true",
                        help="Solo muestra qué haría")
    parser.add_argument("--process", type=str,
                        help="Genera solo el process con este nombre (substring)")
    args = parser.parse_args()

    print("=" * 70)
    print("🖨️  Generador de PROCESS presets OrcaSlicer")
    print("=" * 70)

    config = load_config()
    printer = config["printer"]
    processes = config["processes"]

    output_dir = resolve_orca_dir(printer["profile_path"], "process")
    orca_version = printer.get("orca_version", "2.3.2")
    inherits_base = printer.get("inherit_base", "")

    print(f"📁 Directorio destino: {output_dir}")
    # Avisar si detectó carpeta de cuenta (UUID) o cayó a default/
    if "default" in str(output_dir).split("/user/")[-1].split("/")[0]:
        print("   ⚠️  Escribiendo en default/ (sin cuenta detectada).")
        print("      Si OrcaSlicer no ve los cambios, es porque lees de una")
        print("      carpeta de cuenta. Abre OrcaSlicer, inicia sesión, y reintenta.")
    else:
        print("   ✅ Carpeta de cuenta detectada (donde OrcaSlicer realmente lee)")
    print(f"🏷️  Impresora: {printer['name']}")
    if inherits_base:
        print(f"🧬 Hereda de: {inherits_base}")
    else:
        print(f"⚠️  SIN base de herencia → pueden salir como Unsupported")
    print(f"📦 Process a procesar: {len(processes)}")
    if args.dry_run:
        print("🔍 MODO DRY-RUN (no se escriben archivos)")
    print()

    if not args.dry_run and not output_dir.exists():
        print(f"⚠️  El directorio destino no existe: {output_dir}")
        response = input("   ¿Crearlo? (y/N): ").strip().lower()
        if response != "y":
            print("❌ Cancelado")
            sys.exit(1)
        output_dir.mkdir(parents=True, exist_ok=True)

    success_count = 0
    error_count = 0

    for index, process in enumerate(processes):
        name = process.get("name", f"<sin nombre #{index + 1}>")

        if args.process and args.process.lower() not in name.lower():
            continue

        print(f"▶ {name}")

        if not validate_process(process, index):
            error_count += 1
            print()
            continue

        try:
            profile = build_orca_process(process, orca_version, inherits_base)
            print(f"   🧬 Hereda de: {inherits_base}")
        except KeyError as e:
            print(f"   ❌ Falta parámetro en settings: {e}")
            error_count += 1
            print()
            continue

        output_path = output_dir / f"{name}.json"

        try:
            save_profile(profile, output_path, dry_run=args.dry_run)
            print(f"   💾 {'Simulado' if args.dry_run else 'Generado'}: "
                  f"{output_path.name}")
            success_count += 1
        except (IOError, OSError) as e:
            print(f"   ❌ Error al escribir: {e}")
            error_count += 1

        print()

    print("=" * 70)
    print(f"📊 RESUMEN")
    print("=" * 70)
    print(f"   ✅ Generados:  {success_count}")
    if error_count > 0:
        print(f"   ❌ Errores:    {error_count}")
    print()

    if success_count > 0 and not args.dry_run:
        print("🎯 PRÓXIMOS PASOS:")
        print("   1. Cierra OrcaSlicer (Cmd+Q)")
        print("   2. Vuelve a abrirlo")
        print("   3. Process dropdown → verás los nuevos presets")
        print()

    sys.exit(0 if error_count == 0 else 1)


if __name__ == "__main__":
    main()
